# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL / SQLite fallback for tests)
DATABASE_URL=postgres://localhost:5432/health_risk_db
DB_POOL_SIZE=10

# Redis Cache (Optional for session caching)
REDIS_URL=redis://localhost:6379/0

# Security & OAuth2
JWT_SECRET=change_me_in_production_jwt_signing_key
OAUTH2_CLIENT_ID=health-risk-portal-client
OAUTH2_AUTH_URL=https://auth.healthrisk.org/oauth2/authorize
OAUTH2_TOKEN_URL=https://auth.healthrisk.org/oauth2/token

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000/api/v1
